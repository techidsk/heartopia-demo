{
  "name": "heartopia-guidebook",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Heartopia fan guide website prepared for Cloudflare Pages and AdSense readiness.",
  "scripts": {
    "dev": "astro dev",
    "import:wiki": "node scripts/import-biligame-wiki.mjs",
    "build": "astro build",
    "preview": "npx serve dist",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:i18n": "node scripts/validate-i18n.mjs",
    "report:i18n:data": "node scripts/report-i18n-data.mjs",
    "scaffold:i18n": "node scripts/scaffold-i18n-overlays.mjs",
    "generate:zh-hant": "node scripts/generate-zh-hant-overlays.mjs",
    "generate:seo-locales": "node scripts/generate-seo-locale-overlays.mjs",
    "quality": "node scripts/quality-gate.mjs",
    "qa": "npm run validate:data && npm run validate:i18n && npm run report:i18n:data && npm run build && npm run quality && npm run qa:layout",
    "qa:layout": "node qa/check-layout.mjs",
    "deploy": "npm run build && npx wrangler pages deploy dist --project-name heartopia-blog"
  },
  "devDependencies": {
    "astro": "^6.4.4",
    "opencc-js": "^1.3.1",
    "playwright": "^1.60.0",
    "serve": "^14.2.4",
    "typescript": "^6.0.3",
    "wrangler": "^4.19.1",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  }
}
