---
import StaticContentPage from "@components/StaticContentPage.astro";
import { getStaticPages, type StaticPage } from "@data/staticPages";
import { defaultLocale } from "@i18n/config";

export function getStaticPaths() {
  return getStaticPages(defaultLocale)
    .filter((page) => !["/", "/404.html", "/database/"].includes(page.path))
    .map((page) => ({
      params: { slug: page.path.replace(/^\/|\/$/g, "") },
      props: { page }
    }));
}

interface Props {
  page: StaticPage;
}

const { page } = Astro.props;
---

<StaticContentPage page={page} locale={defaultLocale} />
