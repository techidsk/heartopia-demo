---
import { getSiteConfig } from "@data/site";
import type { StaticPage } from "@data/staticPages";
import { defaultLocale, type Locale } from "@i18n/config";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  page: StaticPage;
  locale?: Locale;
  robots?: string;
}

const { page, locale = defaultLocale, robots = "index,follow,max-image-preview:large" } = Astro.props;
const siteConfig = getSiteConfig(locale);
const canonicalPath = page.path === "/404.html" ? "/404.html" : page.path;
const currentPath = page.path === "/404.html" ? "/" : page.path;
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  canonicalPath={canonicalPath}
  currentPath={currentPath}
  ogImage={page.ogImage || siteConfig.defaultImage}
  robots={robots}
>
  <Fragment set:html={page.content} />
  <script>
    import { initStaticPageInteractions } from "@tools/staticPageInteractions";
    initStaticPageInteractions();
  </script>
</BaseLayout>
