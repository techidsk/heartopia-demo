---
import { getSiteConfig } from "@data/site";
import { getStaticPageAlternateLocalePaths, type StaticPage } from "@data/staticPages";
import { defaultLocale, isLocaleIndexable, localizePath, type Locale } from "@i18n/config";
import { getUiMessages } from "@i18n/messages";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  page: StaticPage;
  locale?: Locale;
  robots?: string;
}

const { page, locale = defaultLocale, robots } = Astro.props;
const siteConfig = getSiteConfig(locale);
const messages = getUiMessages(locale);
const canonicalPath = page.path === "/404.html" ? "/404.html" : page.path;
const currentPath = page.path === "/404.html" ? "/" : page.path;
const resolvedRobots =
  robots ||
  (!isLocaleIndexable(locale) || page.translationStatus === "fallback" || page.translationStatus === "draft"
    ? "noindex,follow"
    : "index,follow,max-image-preview:large");
const showFallbackNotice = page.translationStatus === "fallback";
const alternateLocalePaths = await getStaticPageAlternateLocalePaths(canonicalPath);
---

<BaseLayout
  title={page.title}
  description={page.description}
  locale={locale}
  canonicalPath={canonicalPath}
  currentPath={currentPath}
  ogImage={page.ogImage || siteConfig.defaultImage}
  robots={resolvedRobots}
  alternateLocalePaths={alternateLocalePaths}
>
  {showFallbackNotice && (
    <section class="wiki-section tint-mint">
      <div class="wiki-shell">
        <div class="source-panel">
          <h2>{messages.translation.fallbackTitle}</h2>
          <p>{messages.translation.fallbackBody}</p>
          <a class="pastel-button alt" href={localizePath(canonicalPath, defaultLocale)}>{messages.translation.openEnglish}</a>
        </div>
      </div>
    </section>
  )}
  <Fragment set:html={page.content} />
  <script>
    import { initStaticPageInteractions } from "@tools/staticPageInteractions";
    initStaticPageInteractions();
  </script>
</BaseLayout>
