---
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<div class="breadcrumb">
  {items.map((item, index) => (
    <>
      {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
      {index < items.length - 1 && <span>›</span>}
    </>
  ))}
</div>
