---
import { getNavGroups, getSiteConfig } from "@data/site";
import { canRenderLocalizedRoute } from "@data/routes";
import { defaultLocale, getLocaleMeta, localizePath, sourcePathFromLocalizedPath, supportedLocales, type Locale } from "@i18n/config";
import { getUiMessages } from "@i18n/messages";

interface Props {
  currentPath?: string;
  locale?: Locale;
}

const { currentPath = Astro.url.pathname, locale = defaultLocale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const navGroups = getNavGroups(locale);
const messages = getUiMessages(locale);
const homePath = localizePath("/", locale);
const sourceCurrentPath = sourcePathFromLocalizedPath(currentPath);
const normalizedCurrent = sourceCurrentPath.endsWith("/") ? sourceCurrentPath : `${sourceCurrentPath}/`;
const isCurrent = (href: string) => {
  const sourceHref = sourcePathFromLocalizedPath(href);
  const normalizedHref = sourceHref.endsWith("/") ? sourceHref : `${sourceHref}/`;
  if (normalizedHref === "/") return normalizedCurrent === "/";
  return normalizedCurrent.startsWith(normalizedHref);
};
const isGroupCurrent = (links: Array<{ href: string }>) => links.some((link) => isCurrent(link.href));
const languageLinks = await Promise.all(
  supportedLocales.map(async (targetLocale) => {
    const canUseCurrentPath = await canRenderLocalizedRoute(sourceCurrentPath, targetLocale);
    return {
      locale: targetLocale,
      label: getLocaleMeta(targetLocale).label,
      href: localizePath(canUseCurrentPath ? sourceCurrentPath : "/", targetLocale),
      current: targetLocale === locale
    };
  })
);
---

<header class="site-header">
  <nav class="nav" aria-label={messages.navigation.primaryLabel}>
    <a class="brand" href={homePath}>
      <img class="brand-logo" src={siteConfig.logo} alt="" width="42" height="42" />
      <span>{siteConfig.name}</span>
    </a>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="primary-links"
      data-menu-button
      data-menu-label={messages.navigation.menu}
      data-close-label={messages.navigation.close}
    >
      <span class="menu-button-icon" aria-hidden="true"></span>
      <span data-menu-button-label>{messages.navigation.menu}</span>
    </button>
    <div class="nav-links" id="primary-links" data-nav-links>
      {navGroups.map((group, index) => (
        <div class:list={["nav-group", { "is-active": isGroupCurrent(group.links) }]} data-nav-group>
          <button
            class="nav-group-trigger"
            type="button"
            aria-expanded="false"
            aria-controls={`nav-panel-${index}`}
            data-nav-trigger
          >
            <span>{group.label}</span>
            <span class="nav-chevron" aria-hidden="true"></span>
          </button>
          <div class="nav-dropdown" id={`nav-panel-${index}`} data-nav-dropdown>
            {group.links.map((item) => (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a>
            ))}
          </div>
        </div>
      ))}
      <div class="nav-group language-nav-group" data-nav-group>
        <button
          class="nav-group-trigger"
          type="button"
          aria-expanded="false"
          aria-controls="nav-panel-language"
          data-nav-trigger
        >
          <span>{messages.navigation.languageLabel}</span>
          <span class="nav-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-dropdown language-dropdown" id="nav-panel-language" data-nav-dropdown>
          {languageLinks.map((item) => (
            <a href={item.href} aria-current={item.current ? "page" : undefined}>{item.label}</a>
          ))}
        </div>
      </div>
    </div>
  </nav>
</header>
