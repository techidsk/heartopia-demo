---
import { getDefaultFooterGroups, getSiteConfig, type FooterGroup } from "@data/site";
import { defaultLocale, localizePath, type Locale } from "@i18n/config";
import { formatMessage, getUiMessages } from "@i18n/messages";

interface Props {
  groups?: FooterGroup[];
  locale?: Locale;
}

const { groups, locale = defaultLocale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const messages = getUiMessages(locale);
const resolvedGroups = groups || getDefaultFooterGroups(locale);
const homePath = localizePath("/", locale);
const updatedText = formatMessage(messages.footer.updated, { updatedLabel: siteConfig.updatedLabel });
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a class="brand" href={homePath}>
        <img class="brand-logo" src={siteConfig.logo} alt="" width="42" height="42" />
        <span>{siteConfig.name}</span>
      </a>
      <p class="small">{updatedText}</p>
    </div>
    {resolvedGroups.map((group) => (
      <div class="footer-links">
        <strong>{group.title}</strong>
        {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    ))}
  </div>
</footer>
