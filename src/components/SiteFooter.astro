---
import { defaultFooterGroups, siteConfig } from "@data/site";

type FooterGroup = {
  title: string;
  links: Array<{ href: string; label: string }>;
};

interface Props {
  groups?: FooterGroup[];
}

const { groups = defaultFooterGroups } = Astro.props;
---

<footer class="site-footer">
  <div class="footer-grid">
    <div>
      <a class="brand" href="/">
        <img class="brand-logo" src={siteConfig.logo} alt="" width="42" height="42" />
        <span>{siteConfig.name}</span>
      </a>
      <p class="small">Independent fan guide. Last updated {siteConfig.updatedLabel}.</p>
    </div>
    {groups.map((group) => (
      <div class="footer-links">
        <strong>{group.title}</strong>
        {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
    ))}
  </div>
</footer>
