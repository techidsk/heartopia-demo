---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import MetricCards from "@components/MetricCards.astro";
import { getHeartopiaData, type Shop } from "@data/heartopia";
import { getSiteConfig } from "@data/site";
import { localizePath, type Locale } from "@i18n/config";
import { getDataUiMessages } from "@i18n/dataUi";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  shop: Shop;
  locale: Locale;
}

const { shop, locale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const labels = siteConfig.linkLabels;
const ui = getDataUiMessages(locale);
const { shops } = await getHeartopiaData(locale);
const related = shops.filter((candidate) => candidate.id !== shop.id && candidate.type === shop.type).slice(0, 4);
const detailPath = `/shops/${shop.id}/`;
const title = `${shop.name} - Heartopia ${labels.shops} ${labels.map}`;
const description = `Heartopia ${labels.shops}: ${shop.name}. ${shop.owner}; ${shop.region}; ${shop.unlock}.`;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={detailPath}
  currentPath="/shops/"
  ogImage="/assets/asset-map.jpg"
>
  <section class="article-hero">
    <div class="wiki-shell">
      <Breadcrumbs
        items={[
          { href: localizePath("/", locale), label: labels.home },
          { href: localizePath("/shops/", locale), label: labels.shops },
          { label: shop.name }
        ]}
      />
      <h1>{shop.name}</h1>
      <p>{shop.notes}</p>
      <MetricCards
        metrics={[
          { value: shop.icon, label: ui.shop.icon },
          { value: shop.owner, label: ui.shop.owner },
          { value: shop.type, label: ui.shop.type },
          { value: shop.region, label: ui.shop.region }
        ]}
      />
    </div>
  </section>

  <section class="wiki-section">
    <div class="wiki-shell database-grid">
      <article class="wiki-card">
        <h2 class="wiki-title">{ui.shop.routeTitle}</h2>
        <div class="shop-inventory-grid">
          {shop.inventory.map((item) => <span>{item}</span>)}
        </div>
        <div class="map-meta">
          <span><strong>{ui.shop.unlock}:</strong> {shop.unlock}</span>
          <span><strong>{ui.shop.hours}:</strong> {shop.hours}</span>
          <span><strong>{ui.shop.mapMarker}:</strong> {shop.mapMarkerId}</span>
        </div>
        <div class="entity-action-grid">
          <a class="pastel-button" href={localizePath(shop.links.map || "/map/", locale)}>{ui.actions.viewMap}</a>
          {shop.links.npc && <a class="pastel-button alt" href={localizePath(shop.links.npc, locale)}>{ui.actions.characterRoute}</a>}
          {shop.links.tool && <a class="pastel-button alt" href={localizePath(shop.links.tool, locale)}>{ui.actions.relatedTool}</a>}
        </div>
      </article>
      <aside class="wiki-card">
        <h2 class="wiki-title">{ui.common.dataStatus}</h2>
        <p>{ui.shop.status}</p>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="wiki-section tint-mint">
      <div class="wiki-shell">
        <div class="center-head">
          <h2>{ui.shop.relatedTitle}</h2>
          <p>{ui.shop.relatedText}</p>
        </div>
        <div class="route-grid">
          {related.map((candidate) => (
            <a class="route-card" href={localizePath(`/shops/${candidate.id}/`, locale)}>
              <h3>{candidate.name}</h3>
              <p>{candidate.owner} | {candidate.region}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
