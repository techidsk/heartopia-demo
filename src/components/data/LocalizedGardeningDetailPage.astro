---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import MetricCards from "@components/MetricCards.astro";
import { getHeartopiaData, type Gardening } from "@data/heartopia";
import { getSiteConfig } from "@data/site";
import { localizePath, type Locale } from "@i18n/config";
import { getDataUiMessages } from "@i18n/dataUi";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  item: Gardening;
  locale: Locale;
}

const { item, locale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const labels = siteConfig.linkLabels;
const ui = getDataUiMessages(locale);
const { gardening } = await getHeartopiaData(locale);
const related = gardening.filter((candidate) => candidate.id !== item.id && candidate.category === item.category).slice(0, 4);
const detailPath = `/gardening/${item.id}/`;
const title = `${item.name} - Heartopia ${labels.gardening} ${labels.database}`;
const description = `Heartopia ${labels.gardening}: ${item.name}. ${item.nameZh}; ${item.hobbyLevel}; ${item.season}; ${item.route}.`;
---

<BaseLayout title={title} description={description} locale={locale} canonicalPath={detailPath} currentPath={detailPath} ogImage={item.image}>
  <section class="article-hero">
    <div class="wiki-shell">
      <Breadcrumbs
        items={[
          { href: localizePath("/", locale), label: labels.home },
          { href: localizePath("/gardening/", locale), label: labels.gardening },
          { label: item.name }
        ]}
      />
      <h1>{item.name}</h1>
      <p>{ui.gardening.heroSuffix(item.nameZh)}</p>
      <MetricCards
        metrics={[
          { value: item.hobbyLevel, label: ui.common.hobbyLevel },
          { value: item.season, label: ui.common.season },
          { value: item.category, label: ui.common.type },
          { value: `#${item.number}`, label: ui.common.wikiNumber }
        ]}
      />
    </div>
  </section>

  <section class="wiki-section">
    <div class="wiki-shell database-grid">
      <article class="wiki-card">
        <div class="collection-detail-head">
          <img src={item.image} alt={`${item.name} ${ui.gardening.iconAlt}`} loading="eager" />
          <div>
            <h2 class="wiki-title">{item.name}</h2>
            <p>{item.nameZh}</p>
          </div>
        </div>
        <div class="map-meta">
          <span><strong>{ui.gardening.time}:</strong> {item.time}</span>
          <span><strong>{ui.gardening.weather}:</strong> {item.weather}</span>
          <span><strong>{ui.common.route}:</strong> {item.route}</span>
          <span><strong>{ui.common.source}:</strong> {item.source}</span>
        </div>
        <p>{item.lore}</p>
        <div class="entity-action-grid">
          <a class="pastel-button" href={localizePath("/gardening/", locale)}>{labels.gardening}</a>
          <a class="pastel-button alt" href={item.wikiUrl} rel="nofollow noopener" target="_blank">{ui.actions.openWikiSource}</a>
        </div>
      </article>
      <aside class="wiki-card">
        <h2 class="wiki-title">{ui.common.dataStatus}</h2>
        <p>{ui.gardening.status}</p>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="wiki-section tint-mint">
      <div class="wiki-shell">
        <div class="center-head">
          <h2>{ui.gardening.relatedTitle}</h2>
          <p>{ui.gardening.relatedText}</p>
        </div>
        <div class="route-grid">
          {related.map((candidate) => (
            <a class="route-card" href={localizePath(`/gardening/${candidate.id}/`, locale)}>
              <img class="table-icon" src={candidate.image} alt={`${candidate.name} ${ui.gardening.iconAlt}`} loading="lazy" />
              <h3>{candidate.name}</h3>
              <p>{candidate.nameZh} | {candidate.hobbyLevel} {ui.gardening.levelSuffix}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
