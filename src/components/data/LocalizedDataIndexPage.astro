---
import { getHeartopiaData } from "@data/heartopia";
import { getSiteConfig } from "@data/site";
import { getLocaleMeta, localizePath, type Locale } from "@i18n/config";
import { getDataUiMessages } from "@i18n/dataUi";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const siteConfig = getSiteConfig(locale);
const localeMeta = getLocaleMeta(locale);
const labels = siteConfig.linkLabels;
const ui = getDataUiMessages(locale);
const data = await getHeartopiaData(locale);

const pageLabelByPath: Record<string, string> = {
  "/database/": labels.database,
  "/fish/": labels.fish,
  "/shops/": labels.shops,
  "/crops/": labels.crops,
  "/gardening/": labels.gardening,
  "/insects/": labels.insects,
  "/recipes/": labels.recipes,
  "/characters/": labels.characters,
  "/codes/": labels.codes,
  "/events/": labels.events,
  "/pets/": labels.pets,
  "/hobbies/": labels.hobbies,
  "/tools/": labels.tools
};
const localizedHeading = pageLabelByPath[path] || labels.database;
const copy = {
  title: `Heartopia ${localizedHeading} - ${localeMeta.label}`,
  description: ui.index.description(localizedHeading, labels.database, labels.map, labels.tools, labels.guides),
  eyebrow: ui.index.eyebrow(localizedHeading),
  heading: localizedHeading,
  intro: ui.index.intro(localizedHeading, labels.database, labels.map, labels.tools, labels.guides),
  currentPath: path in pageLabelByPath ? path : "/database/"
};
const link = (href: string) => localizePath(href, locale);
const cardLimit = path === "/database/" ? 12 : 999;

const summaryCards = [
  { value: data.fish.length, label: labels.fish },
  { value: data.shops.length, label: labels.shops },
  { value: data.crops.length, label: labels.crops },
  { value: data.gardening.length, label: labels.gardening },
  { value: data.insects.length, label: labels.insects },
  { value: data.recipes.length, label: labels.recipes },
  { value: data.npcs.length, label: labels.characters },
  { value: data.pets.length, label: labels.pets },
  { value: data.hobbies.length, label: labels.hobbies },
  { value: data.tools.length, label: labels.tools },
  { value: data.codes.activeCandidates.length, label: labels.codes },
  { value: data.events.length, label: labels.events }
];

const riskLabel = (risk: string) => ui.risk[risk] || risk;
---

<BaseLayout title={copy.title} description={copy.description} locale={locale} canonicalPath={path} currentPath={copy.currentPath}>
  <section class="article-hero">
    <div class="wiki-shell">
      <div class="breadcrumb"><a href={link("/")}>{labels.home}</a><span>›</span><span>{copy.heading}</span></div>
      <span class="top-note">{copy.eyebrow}</span>
      <h1>{copy.heading}</h1>
      <p>{copy.intro}</p>
      <div class="page-metrics">
        {summaryCards.slice(0, 4).map((item) => (
          <div class="metric-card"><strong>{item.value}</strong><span>{item.label}</span></div>
        ))}
      </div>
    </div>
  </section>

  {path === "/database/" && (
    <section class="wiki-section">
      <div class="wiki-shell card-grid">
        {[
          { href: "/fish/", title: labels.fish, text: ui.index.fishRoutes(data.fish.length), image: "/assets/asset-fishing.jpg" },
          { href: "/shops/", title: labels.shops, text: ui.index.shopNodes(data.shops.length), image: "/assets/asset-map.jpg" },
          { href: "/crops/", title: labels.crops, text: ui.index.cropRecords(data.crops.length), image: "/assets/asset-gardening.jpg" },
          { href: "/gardening/", title: labels.gardening, text: ui.index.gardeningRecords(data.gardening.length), image: "/assets/wiki/gardening/tomato.png" },
          { href: "/insects/", title: labels.insects, text: ui.index.insectRecords(data.insects.length), image: "/assets/wiki/insects/insect-001.png" },
          { href: "/recipes/", title: labels.recipes, text: ui.index.recipeRoutes(data.recipes.length), image: "/assets/asset-events.jpg" },
          { href: "/characters/", title: labels.characters, text: ui.index.characters(data.npcs.length), image: "/assets/wiki/characters/blanc.png" },
          { href: "/pets/", title: labels.pets, text: ui.index.petRoutes(data.pets.length), image: "/assets/asset-pets.jpg" },
          { href: "/hobbies/", title: labels.hobbies, text: ui.index.hobbyRoutes(data.hobbies.length), image: "/assets/asset-events.jpg" },
          { href: "/tools/", title: labels.tools, text: ui.index.toolEntries(data.tools.length), image: "/assets/asset-gardening.jpg" },
          { href: "/codes/", title: labels.codes, text: ui.index.codeCandidates(data.codes.activeCandidates.length), image: "/assets/asset-events.jpg" },
          { href: "/events/", title: labels.events, text: ui.index.eventItems(data.events.length), image: "/assets/asset-events.jpg" }
        ].slice(0, cardLimit).map((item) => (
          <a class="route-card" href={link(item.href)}>
            <img src={item.image} alt="" loading="lazy" />
            <strong>{item.title}</strong>
            <span>{item.text}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  {path === "/fish/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.fish.map((item) => <a class="route-card" href={link(`/fish/${item.id}/`)}><strong>{item.name}</strong><span>{item.spot}</span><span>{item.condition} · {item.window} · {item.level}</span><small>{item.use}</small></a>)}
    </div></section>
  )}

  {path === "/shops/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.shops.map((item) => <a class="route-card" href={link(`/shops/${item.id}/`)}><strong>{item.name}</strong><span>{item.owner} · {item.region}</span><span>{item.inventory.slice(0, 3).join(" / ")}</span><small>{item.notes}</small></a>)}
    </div></section>
  )}

  {path === "/crops/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.crops.map((item) => <a class="route-card" href={link(`/crops/${item.id}/`)}><strong>{item.name}</strong><span>{item.group} · {item.growth} · {item.unlock}</span><span>{ui.index.seedSell(item.seed, item.sell)}</span><small>{item.use}</small></a>)}
    </div></section>
  )}

  {path === "/gardening/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.gardening.map((item) => <a class="route-card" href={link(`/gardening/${item.id}/`)}><strong>{item.name}</strong><span>{item.season} · {item.time} · {item.weather}</span><span>{item.route}</span><small>{item.lore}</small></a>)}
    </div></section>
  )}

  {path === "/insects/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.insects.map((item) => <a class="route-card" href={link(`/insects/${item.id}/`)}><strong>{item.name}</strong><span>{item.season} · {item.time} · {item.weather}</span><span>{ui.index.rarityLine(item.route, item.rarity)}</span><small>{item.lore}</small></a>)}
    </div></section>
  )}

  {path === "/recipes/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.recipes.map((item) => <a class="route-card" href={link(`/recipes/${item.id}/`)}><strong>{item.name}</strong><span>{item.ingredients.join(" / ")}</span><span>{ui.index.riskLine(item.route, riskLabel(item.risk))}</span><small>{item.use}</small></a>)}
    </div></section>
  )}

  {path === "/characters/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.npcs.map((item) => <a class="route-card" href={link(`/characters/${item.id}/`)}><strong>{item.name}</strong><span>{item.role} · {item.location}</span><span>{item.gifts.slice(0, 3).join(" / ")}</span><small>{item.schedule}</small></a>)}
    </div></section>
  )}

  {path === "/codes/" && (
    <section class="wiki-section"><div class="wiki-shell database-grid">
      <article class="wiki-card"><h2 class="wiki-title">{ui.index.activeCandidates}</h2>{data.codes.activeCandidates.map((item) => <div class="source-panel"><strong>{item.code}</strong><p>{item.rewards.join(" / ")}</p>{item.note && <small>{item.note}</small>}</div>)}</article>
      <aside class="wiki-card code-expired-list"><h2 class="wiki-title">{ui.index.expiredArchive}</h2>{data.codes.expiredArchive.map((item) => <p class="expired-code-row"><strong><s>{item.code}</s></strong><br /><span>{item.reportedReward}</span> · <em>{item.expired}</em></p>)}</aside>
    </div></section>
  )}

  {path === "/events/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.events.map((item) => <div class="route-card"><strong>{item.name}</strong><span>{item.window}</span><span>{item.route}</span><small>{item.rewards.join(" / ")}</small></div>)}
    </div></section>
  )}

  {path === "/pets/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.pets.map((item) => <div class="route-card"><strong>{item.name}</strong><span>{item.category} · {item.route}</span><span>{item.food.join(" / ")}</span><small>{item.unlock}</small></div>)}
    </div></section>
  )}

  {path === "/hobbies/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.hobbies.map((item) => <a class="route-card" href={link(item.primary)}><strong>{item.name}</strong><span>{item.group}</span><small>{item.summary}</small></a>)}
    </div></section>
  )}

  {path === "/tools/" && (
    <section class="wiki-section"><div class="wiki-shell card-grid">
      {data.tools.map((item) => <a class="route-card" href={link(item.href)}><strong>{item.title}</strong><span>{item.category} · {item.status}</span><span>{item.linkedData.join(" / ")}</span><small>{item.useCase}</small></a>)}
    </div></section>
  )}
</BaseLayout>
