---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import MetricCards from "@components/MetricCards.astro";
import { getHeartopiaData, type Insect } from "@data/heartopia";
import { getSiteConfig } from "@data/site";
import { localizePath, type Locale } from "@i18n/config";
import { getDataUiMessages } from "@i18n/dataUi";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  item: Insect;
  locale: Locale;
}

const { item, locale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const labels = siteConfig.linkLabels;
const ui = getDataUiMessages(locale);
const { insects } = await getHeartopiaData(locale);
const related = insects.filter((candidate) => candidate.id !== item.id && candidate.route === item.route).slice(0, 4);
const detailPath = `/insects/${item.id}/`;
const title = `${item.name} - Heartopia ${labels.insects} ${labels.database}`;
const description = `Heartopia ${labels.insects}: ${item.name}. ${item.time}; ${item.weather}; ${item.route}; ${item.rarity}; ${item.hobbyLevel}.`;
---

<BaseLayout title={title} description={description} locale={locale} canonicalPath={detailPath} currentPath="/insects/" ogImage={item.image}>
  <section class="article-hero">
    <div class="wiki-shell">
      <Breadcrumbs
        items={[
          { href: localizePath("/", locale), label: labels.home },
          { href: localizePath("/insects/", locale), label: labels.insects },
          { label: item.name }
        ]}
      />
      <h1>{item.name}</h1>
      <p>{item.lore}</p>
      <MetricCards
        metrics={[
          { value: item.time, label: ui.gardening.time },
          { value: item.weather, label: ui.gardening.weather },
          { value: item.rarity, label: ui.common.rarity },
          { value: item.hobbyLevel, label: ui.common.hobbyLevel }
        ]}
      />
    </div>
  </section>

  <section class="wiki-section">
    <div class="wiki-shell database-grid">
      <article class="wiki-card">
        <div class="collection-detail-head">
          <img src={item.image} alt={`${item.name} ${ui.insect.iconAlt}`} loading="eager" />
          <div>
            <h2 class="wiki-title">{item.name}</h2>
            <p>{item.source}</p>
          </div>
        </div>
        <div class="map-meta">
          <span><strong>{ui.common.season}:</strong> {item.season}</span>
          <span><strong>{ui.common.route}:</strong> {item.route}</span>
          <span><strong>{ui.common.wikiNumber}:</strong> #{item.number}</span>
          <span><strong>{ui.common.iconFile}:</strong> {item.iconFile}</span>
        </div>
        <div class="entity-action-grid">
          <a class="pastel-button" href={localizePath("/insects/", locale)}>{labels.insects}</a>
          <a class="pastel-button alt" href={item.wikiUrl} rel="nofollow noopener" target="_blank">{ui.actions.openWikiSource}</a>
        </div>
      </article>
      <aside class="wiki-card">
        <h2 class="wiki-title">{ui.insect.statusTitle}</h2>
        <p>{ui.insect.status}</p>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="wiki-section tint-blue">
      <div class="wiki-shell">
        <div class="center-head">
          <h2>{ui.insect.relatedTitle}</h2>
          <p>{ui.insect.relatedText}</p>
        </div>
        <div class="route-grid">
          {related.map((candidate) => (
            <a class="route-card" href={localizePath(`/insects/${candidate.id}/`, locale)}>
              <img class="table-icon" src={candidate.image} alt={`${candidate.name} ${ui.insect.iconAlt}`} loading="lazy" />
              <h3>{candidate.name}</h3>
              <p>{candidate.time} | {candidate.weather}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
