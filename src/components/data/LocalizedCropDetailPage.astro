---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import MetricCards from "@components/MetricCards.astro";
import { getHeartopiaData, type Crop } from "@data/heartopia";
import { getSiteConfig } from "@data/site";
import { localizePath, type Locale } from "@i18n/config";
import { formatLocalizedGold, getDataUiMessages } from "@i18n/dataUi";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  crop: Crop;
  locale: Locale;
}

const { crop, locale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const labels = siteConfig.linkLabels;
const ui = getDataUiMessages(locale);
const { crops, recipes } = await getHeartopiaData(locale);
const formatGold = (value: number | null) => formatLocalizedGold(value, locale, ui);
const margin = crop.seed === null || crop.sell === null ? ui.common.unknown : formatGold(crop.sell - crop.seed);
const cropName = crop.name.toLowerCase();
const recipeUses = recipes
  .filter((recipe) => recipe.ingredients.some((ingredient) => ingredient.toLowerCase().includes(cropName)))
  .slice(0, 4);
const relatedCrops = crops.filter((candidate) => candidate.id !== crop.id && candidate.group === crop.group).slice(0, 4);
const detailPath = `/crops/${crop.id}/`;
const title = `${crop.name} - Heartopia ${labels.crops} ${labels.recipes} ${labels.tools}`;
const description = `Heartopia ${labels.crops}: ${crop.name}. ${crop.growth}; ${crop.unlock}; ${crop.use}.`;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={detailPath}
  currentPath={detailPath}
  ogImage={crop.image || "/assets/asset-gardening.jpg"}
>
  <section class="article-hero">
    <div class="wiki-shell">
      <Breadcrumbs
        items={[
          { href: localizePath("/", locale), label: labels.home },
          { href: localizePath("/crops/", locale), label: labels.crops },
          { label: crop.name }
        ]}
      />
      <h1>{crop.name}</h1>
      <p>{crop.use}. {ui.crop.heroSuffix}</p>
      <MetricCards
        metrics={[
          { value: crop.growth, label: ui.crop.growth },
          { value: crop.unlock, label: ui.crop.unlock },
          { value: formatGold(crop.seed), label: ui.crop.seed },
          { value: crop.hobbyLevel || formatGold(crop.sell), label: crop.hobbyLevel ? ui.common.levelGate : ui.crop.sell }
        ]}
      />
    </div>
  </section>

  <section class="wiki-section">
    <div class="wiki-shell database-grid">
      <article class="wiki-card">
        {crop.image && (
          <div class="collection-detail-head">
            <img src={crop.image} alt={`${crop.name} ${ui.crop.iconAlt}`} loading="eager" />
            <div>
              <h2 class="wiki-title">{crop.name}</h2>
              <p>{crop.nameZh || crop.name} · {crop.source}</p>
            </div>
          </div>
        )}
        <h2 class="wiki-title">{ui.crop.routeTitle}</h2>
        <div class="map-meta">
          <span><strong>{ui.common.group}:</strong> {crop.group}</span>
          <span><strong>{ui.common.route}:</strong> {crop.route}</span>
          {crop.season && <span><strong>{ui.common.season}:</strong> {crop.season}</span>}
          <span><strong>{ui.crop.margin}:</strong> {margin}</span>
          <span><strong>{ui.common.use}:</strong> {crop.use}</span>
        </div>
        {crop.lore && <p>{crop.lore}</p>}
        <div class="entity-action-grid">
          <a class="pastel-button" href={localizePath(crop.tool, locale)}>{ui.actions.openCropTool}</a>
          <a class="pastel-button alt" href={localizePath(crop.shop, locale)}>{ui.actions.findSeeds}</a>
          <a class="pastel-button alt" href={localizePath(crop.related, locale)}>{ui.actions.relatedUses}</a>
          {crop.wikiUrl && <a class="pastel-button alt" href={crop.wikiUrl} rel="nofollow noopener" target="_blank">{ui.actions.openWikiSource}</a>}
        </div>
      </article>
      <aside class="wiki-card">
        <h2 class="wiki-title">{ui.common.dataStatus}</h2>
        <p>{ui.crop.status}</p>
      </aside>
    </div>
  </section>

  {recipeUses.length > 0 && (
    <section class="wiki-section tint-mint">
      <div class="wiki-shell">
        <div class="center-head">
          <h2>{ui.crop.recipeUsesTitle}</h2>
          <p>{ui.crop.recipeUsesText}</p>
        </div>
        <div class="route-grid">
          {recipeUses.map((recipe) => (
            <a class="route-card" href={localizePath(`/recipes/${recipe.id}/`, locale)}>
              <h3>{recipe.name}</h3>
              <p>{recipe.ingredients.join(", ")}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {relatedCrops.length > 0 && (
    <section class="wiki-section">
      <div class="wiki-shell">
        <div class="center-head">
          <h2>{ui.crop.relatedTitle}</h2>
          <p>{ui.crop.relatedText}</p>
        </div>
        <div class="route-grid">
          {relatedCrops.map((candidate) => (
            <a class="route-card" href={localizePath(`/crops/${candidate.id}/`, locale)}>
              <h3>{candidate.name}</h3>
              <p>{candidate.growth} | {candidate.unlock}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
