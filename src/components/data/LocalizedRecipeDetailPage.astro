---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import MetricCards from "@components/MetricCards.astro";
import { getHeartopiaData, type Recipe } from "@data/heartopia";
import { getSiteConfig } from "@data/site";
import { localizePath, type Locale } from "@i18n/config";
import { getDataUiMessages } from "@i18n/dataUi";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  recipe: Recipe;
  locale: Locale;
}

const { recipe, locale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const labels = siteConfig.linkLabels;
const ui = getDataUiMessages(locale);
const { crops, recipes } = await getHeartopiaData(locale);
const ingredientText = recipe.ingredients.join(" / ");
const ingredientHaystack = ingredientText.toLowerCase();
const sourceCrops = crops.filter((crop) => ingredientHaystack.includes(crop.name.toLowerCase())).slice(0, 4);
const related = recipes.filter((candidate) => candidate.id !== recipe.id && candidate.group === recipe.group).slice(0, 4);
const risk = ui.risk[recipe.risk] || recipe.risk;
const detailPath = `/recipes/${recipe.id}/`;
const title = `${recipe.name} - Heartopia ${labels.recipes} ${labels.tools}`;
const description = `Heartopia ${labels.recipes}: ${recipe.name}. ${ingredientText}; ${recipe.route}; ${risk}.`;
---

<BaseLayout title={title} description={description} locale={locale} canonicalPath={detailPath} currentPath={detailPath} ogImage="/assets/asset-gardening.jpg">
  <section class="article-hero">
    <div class="wiki-shell">
      <Breadcrumbs
        items={[
          { href: localizePath("/", locale), label: labels.home },
          { href: localizePath("/recipes/", locale), label: labels.recipes },
          { label: recipe.name }
        ]}
      />
      <h1>{recipe.name}</h1>
      <p>{recipe.use}. {ui.recipe.heroSuffix}</p>
      <MetricCards
        metrics={[
          { value: recipe.route, label: ui.common.route },
          { value: risk, label: ui.common.risk },
          { value: recipe.ingredients.length, label: ui.common.ingredientCount },
          { value: recipe.source, label: ui.common.source }
        ]}
      />
    </div>
  </section>

  <section class="wiki-section">
    <div class="wiki-shell database-grid">
      <article class="wiki-card">
        <h2 class="wiki-title">{ui.recipe.routeTitle}</h2>
        <div class="recipe-ingredient-list">
          {recipe.ingredients.map((ingredient) => <span>{ingredient}</span>)}
        </div>
        <div class="map-meta">
          <span><strong>{ui.common.group}:</strong> {recipe.group}</span>
          <span><strong>{ui.common.route}:</strong> {recipe.route}</span>
          <span><strong>{ui.common.source}:</strong> {recipe.source}</span>
          <span><strong>{ui.common.use}:</strong> {recipe.use}</span>
        </div>
        <div class="entity-action-grid">
          <a class="pastel-button" href={localizePath(recipe.tool, locale)}>{ui.actions.openRecipeTool}</a>
          <a class="pastel-button alt" href={localizePath(recipe.primary, locale)}>{ui.actions.ingredientSource}</a>
          <a class="pastel-button alt" href={localizePath("/tools/checklist/", locale)}>{ui.actions.saveChecklist}</a>
        </div>
      </article>
      <aside class="wiki-card">
        <h2 class="wiki-title">{ui.common.dataStatus}</h2>
        <p>{ui.recipe.status}</p>
      </aside>
    </div>
  </section>

  {sourceCrops.length > 0 && (
    <section class="wiki-section tint-mint">
      <div class="wiki-shell">
        <div class="center-head">
          <h2>{ui.recipe.sourceCropsTitle}</h2>
          <p>{ui.recipe.sourceCropsText}</p>
        </div>
        <div class="route-grid">
          {sourceCrops.map((crop) => (
            <a class="route-card" href={localizePath(`/crops/${crop.id}/`, locale)}>
              <h3>{crop.name}</h3>
              <p>{crop.growth} | {crop.unlock}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="wiki-section">
      <div class="wiki-shell">
        <div class="center-head">
          <h2>{ui.recipe.relatedTitle}</h2>
          <p>{ui.recipe.relatedText}</p>
        </div>
        <div class="route-grid">
          {related.map((candidate) => (
            <a class="route-card" href={localizePath(`/recipes/${candidate.id}/`, locale)}>
              <h3>{candidate.name}</h3>
              <p>{candidate.ingredients.join(" / ")}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
