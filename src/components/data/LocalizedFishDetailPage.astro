---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import MetricCards from "@components/MetricCards.astro";
import { getHeartopiaData, type Fish } from "@data/heartopia";
import { getSiteConfig } from "@data/site";
import { localizePath, type Locale } from "@i18n/config";
import { getDataUiMessages } from "@i18n/dataUi";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  item: Fish;
  locale: Locale;
}

const { item, locale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const labels = siteConfig.linkLabels;
const ui = getDataUiMessages(locale);
const { fish } = await getHeartopiaData(locale);
const related = fish.filter((candidate) => candidate.id !== item.id && candidate.type === item.type).slice(0, 4);
const waterRoute = ui.waterRoutes[item.type] || item.type;
const rarity = ui.rarity[item.rarity] || item.rarity;
const detailPath = `/fish/${item.id}/`;
const title = `${item.name} - Heartopia ${labels.fish} ${labels.map} ${labels.guides}`;
const description = `Heartopia ${labels.fish}: ${item.name}. ${item.spot}; ${item.condition}; ${item.window}; ${item.level}.`;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={detailPath}
  currentPath={detailPath}
  ogImage="/assets/asset-fishing.jpg"
>
  <section class="article-hero">
    <div class="wiki-shell">
      <Breadcrumbs
        items={[
          { href: localizePath("/", locale), label: labels.home },
          { href: localizePath("/fish/", locale), label: labels.fish },
          { label: item.name }
        ]}
      />
      <h1>{item.name}</h1>
      <p>{item.use}. {ui.fish.heroSuffix}</p>
      <MetricCards
        metrics={[
          { value: waterRoute, label: ui.common.waterRoute },
          { value: rarity, label: ui.common.rarity },
          { value: item.level, label: ui.common.levelGate },
          { value: item.window, label: ui.common.window }
        ]}
      />
    </div>
  </section>

  <section class="wiki-section">
    <div class="wiki-shell database-grid">
      <article class="wiki-card">
        <h2 class="wiki-title">{ui.fish.routeTitle}</h2>
        <div class="map-meta">
          <span><strong>{ui.common.location}:</strong> {item.spot}</span>
          <span><strong>{ui.common.condition}:</strong> {item.condition}</span>
          <span><strong>{ui.common.window}:</strong> {item.window}</span>
          <span><strong>{ui.common.use}:</strong> {item.use}</span>
        </div>
        <div class="entity-action-grid">
          <a class="pastel-button" href={localizePath(item.map, locale)}>{ui.actions.openMapRoute}</a>
          <a class="pastel-button alt" href={localizePath("/tools/fish-tracker/", locale)}>{ui.actions.trackFish}</a>
          <a class="pastel-button alt" href={localizePath("/recipes/", locale)}>{ui.actions.cookingUses}</a>
        </div>
      </article>
      <aside class="wiki-card">
        <h2 class="wiki-title">{ui.common.dataStatus}</h2>
        <p>{ui.fish.status}</p>
      </aside>
    </div>
  </section>

  {related.length > 0 && (
    <section class="wiki-section tint-mint">
      <div class="wiki-shell">
        <div class="center-head">
          <h2>{ui.fish.relatedTitle}</h2>
          <p>{ui.fish.relatedText}</p>
        </div>
        <div class="route-grid">
          {related.map((candidate) => (
            <a class="route-card" href={localizePath(`/fish/${candidate.id}/`, locale)}>
              <h3>{candidate.name}</h3>
              <p>{candidate.spot} | {candidate.condition}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>
