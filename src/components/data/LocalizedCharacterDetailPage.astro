---
import Breadcrumbs from "@components/Breadcrumbs.astro";
import MetricCards from "@components/MetricCards.astro";
import { type Npc } from "@data/heartopia";
import { getSiteConfig } from "@data/site";
import { localizePath, type Locale } from "@i18n/config";
import { getDataUiMessages } from "@i18n/dataUi";
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  npc: Npc;
  locale: Locale;
}

const { npc, locale } = Astro.props;
const siteConfig = getSiteConfig(locale);
const labels = siteConfig.linkLabels;
const ui = getDataUiMessages(locale);
const detailPath = `/characters/${npc.id}/`;
const title = `${npc.name} - Heartopia ${labels.characters} ${labels.map}`;
const description = `Heartopia ${labels.characters}: ${npc.name}. ${npc.role}; ${npc.location}; ${npc.schedule}.`;
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={detailPath}
  currentPath="/characters/"
  ogImage={npc.image || "/assets/asset-map.jpg"}
>
  <section class="article-hero">
    <div class="wiki-shell">
      <Breadcrumbs
        items={[
          { href: localizePath("/", locale), label: labels.home },
          { href: localizePath("/characters/", locale), label: labels.characters },
          { label: npc.name }
        ]}
      />
      <h1>{npc.name}</h1>
      <p>{npc.profile || ui.character.profile(npc.role, npc.location)}</p>
      <MetricCards
        metrics={[
          { value: npc.group, label: ui.common.group },
          { value: npc.role, label: ui.character.role },
          { value: npc.nameZh || npc.name, label: ui.common.sourceName },
          { value: npc.image ? ui.common.wikiPortrait : ui.common.routeData, label: ui.common.imageSource }
        ]}
      />
    </div>
  </section>

  <section class="wiki-section">
    <div class="wiki-shell database-grid">
      <article class="wiki-card">
        <div class="collection-detail-head">
          {npc.image ? (
            <img src={npc.image} alt={`${npc.name} ${ui.character.portraitAlt}`} loading="eager" />
          ) : (
            <span class="npc-badge">{npc.name.slice(0, 2).toUpperCase()}</span>
          )}
          <div>
            <h2 class="wiki-title">{npc.name}</h2>
            <p>{npc.nameZh ? `${npc.nameZh} · ` : ""}{npc.source || ui.character.fanSource}</p>
          </div>
        </div>
        <h2 class="wiki-title">{ui.character.routeTitle}</h2>
        <div class="map-meta">
          <span><strong>{ui.common.location}:</strong> {npc.location}</span>
          <span><strong>{ui.character.schedule}:</strong> {npc.schedule}</span>
          <span><strong>{ui.character.gifts}:</strong> {npc.gifts.join(" / ")}</span>
        </div>
        <div class="entity-action-grid">
          <a class="pastel-button" href={localizePath(npc.map, locale)}>{ui.actions.openMapRoute}</a>
          <a class="pastel-button alt" href={localizePath(npc.shop, locale)}>{ui.actions.shopHandoff}</a>
          <a class="pastel-button alt" href={localizePath(npc.tool, locale)}>{ui.actions.friendshipTool}</a>
          {npc.wikiUrl && <a class="pastel-button alt" href={npc.wikiUrl} rel="nofollow noopener" target="_blank">{ui.actions.openWikiSource}</a>}
        </div>
      </article>
      <aside class="wiki-card">
        <h2 class="wiki-title">{ui.common.dataStatus}</h2>
        <p>{ui.character.status}</p>
      </aside>
    </div>
  </section>
</BaseLayout>
