---
interface Metric {
  value: string | number;
  label: string;
}

interface Props {
  metrics: Metric[];
}

const { metrics } = Astro.props;
---

<div class="page-metrics">
  {metrics.map((metric) => (
    <div class="metric-card">
      <strong>{metric.value}</strong>
      <span>{metric.label}</span>
    </div>
  ))}
</div>
